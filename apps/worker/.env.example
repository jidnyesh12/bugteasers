# Direct Postgres connection. Local value matches `npx supabase start`.
# Hosted Supabase: Project Settings → Database → Connection string (session pooler).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# RabbitMQ. Ignored when the worker runs through docker-compose, which wires it up itself.
RABBITMQ_URL=amqp://bugteasers:bugteasers@localhost:5672
