# ─── NextAuth.js ───
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret

# ─── Supabase (database only, auth is handled by NextAuth) ───
# Local values below match `npx supabase start`. For a hosted project use
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ─── Google Gemini (problem generation and hints) ───
# https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key

# ─── Piston code execution ───
# Local: the Piston container from docker-compose.yml.
# Production: https://<your PISTON_DOMAIN> plus the same PISTON_API_KEY Caddy enforces.
PISTON_API_URL=http://localhost:2000
PISTON_API_KEY=
PISTON_MAX_CONCURRENCY=4

# ─── RabbitMQ (plagiarism analysis jobs for the worker) ───
RABBITMQ_URL=amqp://bugteasers:bugteasers@localhost:5672

# ─── Generated test cases ───
TESTCASE_FANOUT_CANDIDATES=8
TESTCASE_FANOUT_KEEP=3
TESTCASE_MAX_COLLECTION_LENGTH=100000
