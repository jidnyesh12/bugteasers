# Settings read by docker-compose.yml. Copy to .env next to docker-compose.yml.
# App settings live in apps/web/.env and apps/worker/.env.

# ─── RabbitMQ ───
RABBITMQ_USER=bugteasers
RABBITMQ_PASSWORD=bugteasers
# Set to a hosted broker (for example amqps://...cloudamqp.com/...) to use it instead of the local container.
COMPOSE_RABBITMQ_URL=

# ─── Caddy in front of Piston (profile: server) ───
PISTON_DOMAIN=piston.example.com
# Generate with: openssl rand -hex 32
PISTON_API_KEY=

# ─── Web image build (profile: web) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
